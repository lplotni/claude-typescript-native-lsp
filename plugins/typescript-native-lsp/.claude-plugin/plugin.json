{
  "name": "typescript-native-lsp",
  "version": "0.1.0",
  "description": "TypeScript 7 native language server (tsc --lsp --stdio), for workspaces whose TypeScript no longer ships tsserver.js",
  "lspServers": {
    "typescript": {
      "command": "tsc",
      "args": ["--lsp", "--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}
